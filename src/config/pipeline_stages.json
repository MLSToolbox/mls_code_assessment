{
  "phases": {
    "data_engineering": ["data_collection", "data_cleaning", "feature_engineering"],
    "model_development": ["model_training","model_evaluation"]
  },
  "stages": {
    "data_collection": {
      "filename_patterns": [
        "collect", "scrape", "loader", "fetch", "ingest", "extract", "download"
      ],
      "keywords": [
        "pd.read_csv",
        "pd.read_excel",
        "pd.read_json",
        "pd.read_sql",
        "pd.read_parquet",
        "load_dataset",
        "load_iris",
