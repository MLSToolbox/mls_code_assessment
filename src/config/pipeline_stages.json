        "pd.concat",
        "get_dummies",
        "feature_selection",
        "create_features",
        "extract_features",
        "generate_features",
        "OneHotEncoder",
        "LabelEncoder",
        "StandardScaler",
        "MinMaxScaler",
        "RobustScaler",
        "PCA",
        "SelectKBest",
        "VarianceThreshold",
        "TfidfVectorizer",
        "CountVectorizer"
      ],
      "imports": [
        "sklearn.preprocessing",
        "sklearn.feature_extraction",
        "sklearn.decomposition",
        "sklearn.feature_selection",
        "IScaler",
        "IEncoder",
