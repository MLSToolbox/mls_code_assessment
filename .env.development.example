# Configuración para ambiente DEVELOPMENT (desarrollo en servidor gessi.cs.upc.edu)
# Copiar este archivo a .env.development y ajustar según necesidades

ENVIRONMENT=development

# Code Assessment Service Configuration
PORT=5060
HOST=0.0.0.0
DEBUG=True

# Session settings
SESSION_BASE_PATH=/tmp/mls_sessions
SESSION_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=30

# CORS settings (use '*' for development, specific origins for production)
CORS_ORIGINS=*

# Docker Configuration
IMAGE_TAG=mls_toolbox_code_assessment:development
CONTAINER_NAME=mls_toolbox_code_assessment
EXTERNAL_PORT=5060

# Docker Network
DOCKER_NETWORK=mls-network
