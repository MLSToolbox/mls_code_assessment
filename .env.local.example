# Configuración para ambiente LOCAL (desarrollo local)
# Copiar este archivo a .env.local y ajustar según necesidades

ENVIRONMENT=local

# Code Assessment Service Configuration
PORT=5060
HOST=0.0.0.0
DEBUG=True

# Session settings
SESSION_BASE_PATH=/tmp/mls_sessions
SESSION_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=30

# CORS settings (use '*' for development, specific origins for production)
CORS_ORIGINS=*

# Docker Configuration
IMAGE_TAG=mls_toolbox_code_assessment:local
CONTAINER_NAME=mls_toolbox_code_assessment

# Docker Network
DOCKER_NETWORK=mls-network
