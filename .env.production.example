# Configuración para ambiente PRODUCTION (producción en servidor gessi.cs.upc.edu)
# Copiar este archivo a .env.production y ajustar según necesidades

ENVIRONMENT=production

# Code Assessment Service Configuration
PORT=5060
HOST=0.0.0.0
DEBUG=False

# Session settings
SESSION_BASE_PATH=/tmp/mls_sessions
SESSION_TTL_MINUTES=120
CLEANUP_INTERVAL_MINUTES=60

# CORS settings (more restrictive in production)
CORS_ORIGINS=http://gessi.cs.upc.edu:1445,http://gessi.cs.upc.edu:1447

# Docker Configuration
IMAGE_TAG=mls_toolbox_code_assessment:production
CONTAINER_NAME=mls_toolbox_code_assessment

# Docker Network
DOCKER_NETWORK=mls-network
